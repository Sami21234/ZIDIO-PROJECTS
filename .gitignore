data/raw/*.csv
data/raw/*.csv.gz
data/raw/*.xlsx


# Processed data & model - KEPT, not ignored.
# The dashboard and API read these files directly at runtime;
# without them committed, Streamlit Cloud / Render deploys will
# crash on startup with FileNotFoundError.

